# Database
DATABASE_URL="postgresql://username@localhost:5432/sellerfin_dev?schema=public"

# NextAuth Configuration
# IMPORTANT: Update these URLs to match your actual dev server port
# Default Next.js dev server runs on port 3000
# If you're using a different port (e.g., 3002), update accordingly
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API Key (optional - for embeddings and future AI features)
# If not set, embeddings will use placeholder zero vectors
OPENAI_API_KEY="sk-..."

# Perplexity API Key (optional - for research features)
PERPLEXITY_API_KEY="your-perplexity-key-here"
