{
  "name": "seller-financing-platform",
  "version": "1.0.0",
  "description": "SellerFi - A seller financing marketplace platform",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:test": "next lint",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "npx ts-node scripts/seed-sample-listings.ts",
    "postinstall": "prisma generate",
    "deploy:staging": "vercel --prod",
    "deploy:preview": "vercel",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run lib/**/*.test.ts",
    "test:integration": "vitest run __tests__/**/*.test.ts",
    "test:components": "vitest run components/**/*.test.tsx",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:components && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "playwright install",
    "pretest:e2e": "npm run playwright:install"
  },
  "keywords": [
    "seller-financing",
    "marketplace",
    "business-sales"
  ],
  "author": "SellerFi",
  "license": "MIT",
